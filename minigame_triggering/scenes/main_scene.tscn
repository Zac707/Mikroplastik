[sub_resource type="GDScript" id="GDScript_wd80y"]
resource_name = "MinigameTestButton"
script/source = "extends Button


@export var minigame: BaseMinigameSetup
@export_range(1, 3, 1) var fisher_nr: int = 1
@export var decay: Enums.Decay


func _ready() -> void:
	pressed.connect(_on_pressed_test)

func _on_pressed_test() -> void:
	var mods = ObjectMinigameModifiers.new(decay, fisher_nr)
	MinigamesManager.Instance.start_new(minigame, mods)
"

